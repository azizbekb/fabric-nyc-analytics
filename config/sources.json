{
  "repo": {
    "raw_base_url": "https://raw.githubusercontent.com",
    "raw_path": "azizbekb/fabric-nyc-analytics/main",
    "config_path": "config/sources.json"
  },
  "lakehouses": {
    "bronze": "lh_bronze",
    "silver": "lh_silver"
  },
  "warehouse": "wh_gold",
  "taxi": {
    "type": "file",
    "base_url": "https://d37ci6vzurychx.cloudfront.net",
    "path_template": "trip-data/yellow_tripdata_{month}.parquet",
    "months": [
      "2024-01",
      "2024-02",
      "2024-03",
      "2024-04",
      "2024-05",
      "2024-06"
    ],
    "bronze_folder": "taxi",
    "silver_table": "silver_taxi_trips",
    "quarantine_table": "quarantine_taxi_trips",
    "library": "nb_lib_taxi",
    "quality": {
      "max_duration_h": 24,
      "max_distance_mi": 100,
      "max_fare_usd": 1000,
      "void_tolerance_usd": 0.005
    }
  },
  "taxi_zones": {
    "type": "file",
    "base_url": "https://d37ci6vzurychx.cloudfront.net",
    "path": "misc/taxi_zone_lookup.csv",
    "shapefile_path": "misc/taxi_zones.zip",
    "shapefile_member": "taxi_zones/taxi_zones.shp",
    "bronze_folder": "taxi_zones",
    "silver_table": "silver_taxi_zones",
    "library": "nb_lib_taxi"
  },
  "openaq": {
    "type": "api",
    "base_url": "https://api.openaq.org",
    "center": {
      "lat": 40.7128,
      "lon": -74.006
    },
    "radius_m": 25000,
    "monitors_only": true,
    "parameters": [
      "pm25",
      "no2",
      "o3"
    ],
    "locations_path": "v3/locations",
    "daily_path": "v3/sensors/{sensor_id}/days",
    "page_limit": 1000,
    "min_coverage_pct": 75,
    "bronze_table": "bronze_openaq_measurements",
    "silver_table": "silver_air_quality",
    "quarantine_table": "quarantine_air_quality",
    "library": "nb_lib_openaq"
  },
  "monitor_zones": {
    "type": "file",
    "path": "reference/monitor_zones.csv",
    "outside_label": "Outside NYC",
    "bronze_folder": "reference",
    "silver_table": "silver_monitor_zones",
    "library": "nb_lib_openaq"
  },
  "worldbank": {
    "type": "api",
    "base_url": "https://api.worldbank.org",
    "path": "v2/country/USA/indicator/NY.GDP.MKTP.CD",
    "query": {
      "format": "json"
    },
    "per_page": 100,
    "bronze_table": "bronze_worldbank_gdp",
    "silver_table": "silver_gdp",
    "library": "nb_lib_worldbank"
  },
  "ecb": {
    "type": "api",
    "base_url": "https://data-api.ecb.europa.eu",
    "path": "service/data/EXR/D.USD.EUR.SP00.A",
    "query": {
      "format": "csvdata"
    },
    "bronze_table": "bronze_ecb_fx",
    "silver_table": "silver_fx_daily",
    "missing_day_rule": "last_available",
    "library": "nb_lib_ecb"
  }
}
